{
    "name": "ramysoeg/pluma",
    "description": "A lightweight PHP framework with namespace support",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Pluma\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pluma\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.16"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}